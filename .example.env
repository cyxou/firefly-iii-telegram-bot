# Copy to .env and fill in. compose.yaml passes it to the bot via env_file.

# Telegram bot token from @botfather
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot (empty = everyone)
ALLOWED_TG_USER_IDS=

# Set to 'true' to stop logging denied access attempts
#DISABLE_UNAUTHORIZED_USER_LOG=true

# Optional: pre-configure Firefly credentials for every user with no saved
# settings. Users can still override per-user via /settings in Telegram.
FIREFLY_URL=
FIREFLY_ACCESS_TOKEN=

# Usually leave blank — falls back to FIREFLY_URL + /api. Set only when the bot
# reaches Firefly over a different internal URL (e.g. http://firefly:8080/api).
FIREFLY_API_URL=

# Redis for session storage. Leave unset under compose.yaml — it points the
# bot at its bundled Redis automatically. Set it only to use your own Redis
# (and drop the bundled service + depends_on from compose.yaml).
#REDIS_URL=redis://localhost:6379

# pino log level (trace|debug|info|warn|error)
LOG_LEVEL=info

# If you use a self-signed SSL certificate for your Firefly III url, uncomment
# the next line
#NODE_TLS_REJECT_UNAUTHORIZED=0
