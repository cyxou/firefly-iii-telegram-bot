{
  "name": "firefly-iii-telegram-bot",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#root/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run --watch ./src/main.ts",
    "start": "bun run ./src/main.ts",
    "typecheck": "tsc",
    "lint": "oxlint",
    "fix": "oxlint --fix && oxfmt",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "codegen": "openapi-generator-cli generate -i https://raw.githubusercontent.com/firefly-iii/api-docs/v6.7.8/dist/firefly-iii-v6.7.8-v1.yaml -o src/lib/firefly/generated -g typescript-axios -c .openapi-generator-config.yaml --skip-validate-spec"
  },
  "dependencies": {
    "@grammyjs/i18n": "0.5.1",
    "@grammyjs/menu": "1.5.0",
    "@grammyjs/router": "2.0.0",
    "@grammyjs/runner": "2.0.3",
    "@grammyjs/storage-redis": "2.6.0",
    "axios": "1.20.0",
    "dayjs": "1.11.23",
    "grammy": "1.46.0",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.42.0",
    "@types/bun": "1.4.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "pino-pretty": "13.2.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "basic-ftp": "6.2.1"
  }
}
